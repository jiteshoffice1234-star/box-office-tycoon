{
  "name": "box-office-tycoon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --require ./scripts/vite-unc-fix.cjs node_modules/vite/bin/vite.js",
    "build": "node --require ./scripts/vite-unc-fix.cjs node_modules/vite/bin/vite.js build",
    "preview": "node --require ./scripts/vite-unc-fix.cjs node_modules/vite/bin/vite.js preview",
    "sync:android": "node node_modules/@capacitor/cli/bin/capacitor sync android",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "balance": "node node_modules/tsx/dist/cli.mjs scripts/balance.ts",
    "verify": "node node_modules/tsx/dist/cli.mjs scripts/verify-finance.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/karla": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
